# frontend/.env.example을 frontend/.env.local로 복사해서 값을 입력하세요
# Firebase Console > 프로젝트 설정 > 웹 앱에서 확인
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 백엔드를 따로 호스팅할 때만 지정 (예: https://pibi-backend.up.railway.app)
# 지정하지 않으면 같은 도메인의 /api로 요청
VITE_API_URL=
