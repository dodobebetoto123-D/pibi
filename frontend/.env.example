# frontend/.env.example을 frontend/.env.local로 복사해서 값을 입력하세요
# Firebase Console > 프로젝트 설정 > 웹 앱에서 확인
VITE_FIREBASE_API_KEY=<redacted>
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloudflare Worker(AI 프록시) 주소 — wrangler deploy 후 출력되는 workers.dev URL
VITE_WORKER_URL=https://pibi-ai.<계정>.workers.dev
