{
  "name": "ai-planner",
  "version": "1.0.1",
  "description": "pibi desktop React PoC workspace",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "typecheck": "cd frontend && npm run typecheck",
    "desktop:dev": "concurrently -k \"npm --prefix frontend run dev -- --host localhost\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:dist": "npm --prefix frontend run build && electron-builder --win nsis --x64",
    "desktop:pack": "npm --prefix frontend run build && electron-builder --dir --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "npm": "^11.21.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.pibi.desktop",
    "productName": "pibi",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pibi"
    }
  }
}
