rules_version = '2';

// Pibi Firestore 보안 규칙
// - 모든 문서는 로그인한 사용자만 접근
// - projects 문서의 owner_uid가 본인인 경우에만 읽기/쓰기
// - 하위 컬렉션(artifacts/chat/kanban/notes/requests/inspections)은
//   부모 프로젝트의 owner_uid로 소유권을 확인
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.owner_uid == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && resource.data.owner_uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.owner_uid == request.auth.uid;

      match /artifacts/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
      match /chat/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
      match /kanban/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
      match /notes/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
      match /requests/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
      match /inspections/{docId} {
        allow read, write: if isProjectOwner(projectId);
      }
    }
  }
}
