# Groq API Key (https://console.groq.com 에서 발급)
GROQ_API_KEY=your_groq_api_key_here
PORT=3000

# Firebase Admin SDK. Keep service-account credentials out of source control.
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json

# 호스팅용 (로컬에서는 비워두면 기본값 사용)
# DB_PATH=            # SQLite 파일 경로 (기본: backend/data.db)
# HOSTNAME=           # 기본 127.0.0.1, Docker/호스팅에서는 0.0.0.0
# CORS_ORIGINS=       # 배포된 프론트엔드 도메인, 콤마 구분 (예: https://pibi-5fb39.web.app)
